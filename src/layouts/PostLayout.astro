---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  pubDate: Date | string;
  description?: string;
  author?: string;
  tags?: string[];
}

const { title, pubDate, description, author, tags = [] } = Astro.props;

// Format the publication date nicely (e.g., Aug 22, 2026)
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} | Blog`} description={description} pageKey="blog">
  <article class="post-container">
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span>Published on <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time></span>
        {author && <span> • By {author}</span>}
      </div>
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag: string) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <hr class="divider" />

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>