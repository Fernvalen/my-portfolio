---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;

// Format the publication date nicely (e.g., Aug 22, 2026)
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${frontmatter.title} | Blog`}>
  <article class="post-container">
    <header class="post-header">
      <h1>{frontmatter.title}</h1>
      <div class="post-meta">
        <span>Published on <strong>{formattedDate}</strong></span>
        {frontmatter.author && <span> • By {frontmatter.author}</span>}
      </div>
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="tags">
          {frontmatter.tags.map((tag: string) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <hr class="divider" />

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-container {
    max-width: 720px;
    margin: 0 auto;
  }
  .post-header h1 {
    margin-bottom: 0.5rem;
    font-size: 2.2rem;
    line-height: 1.2;
  }
  .post-meta {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .divider {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 1.5rem 0 2rem 0;
  }
  .post-content {
    line-height: 1.8;
  }
</style>