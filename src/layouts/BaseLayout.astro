---
import '../styles/global.css';
import { siteConfig, maintenanceConfig, type PageKey } from '../siteConfig';
import UnderConstruction from '../components/UnderConstruction.astro';

interface Props {
  title?: string;
  description?: string;
  pageKey?: PageKey;
  isUnderConstruction?: boolean;
}

const { 
  title = siteConfig.title, 
  description = siteConfig.description, 
  pageKey, 
  isUnderConstruction = false 
} = Astro.props;

const base = import.meta.env.BASE_URL ?? '';
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;

const isSiteLocked = maintenanceConfig?.siteUnderConstruction ?? false;
const isPageLocked = pageKey && maintenanceConfig?.pagesUnderConstruction 
  ? Boolean(maintenanceConfig.pagesUnderConstruction[pageKey]) 
  : false;

const shouldShowMaintenance = isSiteLocked || isPageLocked || isUnderConstruction;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${normalizedBase}/favicon.svg`} />
    <link rel="alternate icon" href={`${normalizedBase}/favicon.ico`} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main Navigation">
        {siteConfig.navItems.map((item) => {
          const itemHref = item.href === '/' ? `${normalizedBase}/` : `${normalizedBase}${item.href}`;
          const isActive = pageKey === item.key;
          return (
            <a 
              href={itemHref} 
              class={isActive ? 'active' : undefined}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <main>
      {shouldShowMaintenance ? (
        <UnderConstruction customMessage={maintenanceConfig.message} />
      ) : (
        <slot />
      )}
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. Built with modern Astro.</p>
    </footer>
  </body>
</html>