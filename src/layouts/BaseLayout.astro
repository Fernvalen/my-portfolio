---
import '../styles/global.css';
import { maintenanceConfig } from '../siteConfig';
import UnderConstruction from '../components/UnderConstruction.astro';

// Define the valid page keys matching your siteConfig object
type PageKey = keyof typeof maintenanceConfig.pagesUnderConstruction;

interface Props {
  title?: string;
  pageKey?: PageKey; // e.g. 'home', 'about', 'projects', 'blog', 'contact'
  isUnderConstruction?: boolean; // direct override prop
}

const { title = "My Portfolio", pageKey, isUnderConstruction = false } = Astro.props;
const base = import.meta.env.BASE_URL ?? '';

const isSiteLocked = maintenanceConfig?.siteUnderConstruction ?? false;
const isPageLocked = pageKey && maintenanceConfig?.pagesUnderConstruction 
  ? Boolean(maintenanceConfig.pagesUnderConstruction[pageKey]) 
  : false;

const shouldShowMaintenance = isSiteLocked || isPageLocked || isUnderConstruction;
//console.log("Checking Projects:", { pageKey, isPageLocked, shouldShowMaintenance });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/about`}>About</a>
        <a href={`${base}/projects`}>Projects</a>
        <a href={`${base}/blog`}>Blog</a>
        <a href={`${base}/contact`}>Contact</a>
      </nav>
    </header>

    <main>
      {shouldShowMaintenance ? (
        <UnderConstruction customMessage={maintenanceConfig.message} />
      ) : (
        <slot />
      )}
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} My Portfolio. Built with Astro.</p>
    </footer>
  </body>
</html>