---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';

const base = import.meta.env.BASE_URL ?? '';
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<BaseLayout title="Fernando Valenzuela Jr. | Technology Leader & Quality Architect" pageKey="home">
  <!-- 🟢 Reusable Switcher for V1 -->
  <div class="switcher-top-container">
    <VariantSwitcher current="v1" />
  </div>
  
  <div class="canvas-wrapper">
      
    <!-- Passions Vector Backdrop (Soccer, Gaming, Dogs, Travel) -->
    <svg class="passions-backdrop" viewBox="0 0 1000 600" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- ⚽ Soccer -->
      <g stroke="#ea580c" stroke-width="1.5" opacity="0.6">
        <rect x="60" y="80" width="220" height="150" rx="4" fill="none"/>
        <line x1="170" y1="80" x2="170" y2="230"/>
        <circle cx="170" cy="155" r="30" fill="none"/>
        <circle cx="100" cy="120" r="16" fill="none"/>
        <polygon points="100,110 109,116 106,126 94,126 91,116" fill="#ea580c" opacity="0.3"/>
      </g>

      <!-- 🎮 Video Games -->
      <g stroke="#c2410c" stroke-width="1.5" opacity="0.6" transform="translate(720, 70)">
        <rect x="0" y="20" width="180" height="95" rx="30" fill="none"/>
        <path d="M 40 55 L 40 75 M 30 65 L 50 65"/>
        <circle cx="130" cy="60" r="4" fill="#c2410c"/>
        <circle cx="145" cy="70" r="4" fill="#c2410c"/>
        <circle cx="115" cy="70" r="4" fill="#c2410c"/>
        <circle cx="130" cy="80" r="4" fill="#c2410c"/>
        <path d="M 20 105 L 10 140 M 160 105 L 170 140"/>
      </g>

      <!-- 🐕 Dogs -->
      <g stroke="#ea580c" stroke-width="1.5" opacity="0.6" transform="translate(80, 390)">
        <path d="M 20 80 Q 25 30 50 25 Q 75 20 85 45 L 110 50 Q 120 70 110 85 L 85 85 L 80 120 L 50 120 Z" fill="none"/>
        <circle cx="65" cy="45" r="3" fill="#ea580c"/>
        <circle cx="75" cy="100" r="4" fill="#ea580c" opacity="0.4"/>
      </g>

      <!-- ✈️ Travel -->
      <g stroke="#fb923c" stroke-width="1.5" opacity="0.6" transform="translate(720, 380)">
        <circle cx="100" cy="80" r="40" fill="none" stroke-dasharray="4,4"/>
        <polygon points="100,30 106,74 150,80 106,86 100,130 94,86 50,80 94,74" fill="#fb923c" opacity="0.2"/>
        <path d="M -80 120 Q 20 20 120 40" stroke-dasharray="5,5"/>
        <polygon points="120,40 105,38 115,50" fill="#fb923c"/>
      </g>
    </svg>

    <!-- Center Hero Focus (Vertically & Horizontally Centered) -->
    <main class="hero-minimal">
      <h1 class="hero-minimal-name">Fernando Valenzuela Jr.</h1>
      <p class="hero-minimal-title">Technology Leader & Quality Architect</p>
      <p class="hero-minimal-bio">
        Specializing in Enterprise TCoE Governance, AI-Driven Quality Engineering harnesses, and resilient Cloud Application Delivery at scale.
      </p>
      
      <div class="hero-actions">
          <a href={`${normalizedBase}/about`} class="btn primary-btn">View Executive Profile</a>
          <a href={`${normalizedBase}/projects`} class="btn secondary-btn">Explore Projects</a>
      </div>

      <!-- Combined Docks Container (Fixed on Desktop, Stacked Below Button on Mobile) -->
      <div class="mobile-docks-container">
        
        <!-- Left Dock Icons: Contact & Socials -->
        <aside class="margin-dock dock-left" aria-label="Social and Contact Channels">
          <a href="mailto:fernvalenjr@gmail.com" class="dock-btn" data-tooltip="Email Me" aria-label="Send Email">
            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/fernando-valenzuela-jr/" target="_blank" rel="noopener noreferrer" class="dock-btn" data-tooltip="LinkedIn Profile" aria-label="LinkedIn Profile">
            <svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.45 1.45 0 0 0 1.45-1.45 1.45 1.45 0 0 0-1.45-1.45 1.45 1.45 0 0 0-1.45 1.45c0 .8.65 1.45 1.45 1.45m1.39 9.74v-8.37H5.07v8.37h2.78z"/></svg>
          </a>
          <a href="https://github.com/Fernvalen" target="_blank" rel="noopener noreferrer" class="dock-btn" data-tooltip="GitHub Repositories" aria-label="GitHub Repositories">
            <svg viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
          </a>
        </aside>

      </div>

    </main>

  </div>

</BaseLayout>

