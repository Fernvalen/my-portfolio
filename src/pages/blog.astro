---
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetches all Markdown files in the posts directory
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog | My Portfolio" pageKey="blog">
  <section>
    <h1>Blog ✍️</h1>
    <p>Thoughts, tutorials, and notes on software engineering and technology.</p>

    <div class="blog-list">
      {allPosts.map((post: any) => (
        <article class="post-item">
          <h2>
            <a href={post.url}>{post.frontmatter.title}</a>
          </h2>
          <p class="post-date">{post.frontmatter.pubDate.slice(0, 10)}</p>
          <p>{post.frontmatter.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .post-item {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
  }
  .post-item h2 {
    margin-bottom: 0.25rem;
  }
  .post-date {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
</style>