---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetches all blog posts and sorts by pubDate descending
const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const base = import.meta.env.BASE_URL ?? '';
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<BaseLayout 
  title="Blog | Fernando Valenzuela Jr." 
  description="Thoughts, tutorials, and notes on software quality engineering, AI testing, and cloud architecture."
  pageKey="blog"
>
  <section>
    <h1>Blog ✍️</h1>
    <p>Thoughts, tutorials, and notes on software engineering, AI quality, and cloud technology.</p>

    <div class="blog-list">
      {allPosts.map((post) => {
        const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          timeZone: 'UTC',
        });
        return (
          <article class="post-item">
            <h2>
              <a href={`${normalizedBase}/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="post-date">
              <time datetime={new Date(post.data.pubDate).toISOString()}>{formattedDate}</time>
              {post.data.author && <span> • {post.data.author}</span>}
            </p>
            <p>{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag: string) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>