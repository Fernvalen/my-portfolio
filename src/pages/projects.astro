---
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = [
  {
    title: "Personal Portfolio",
    description: "A fast, responsive portfolio built with Astro and hosted on GitHub Pages.",
    link: "https://github.com/your-username/my-portfolio",
    tags: ["Astro", "HTML", "CSS"]
  },
  {
    title: "Task Tracker App",
    description: "A productivity web application to manage daily tasks and deadlines.",
    link: "https://github.com/your-username/task-tracker",
    tags: ["JavaScript", "Local Storage", "CSS"]
  },
  {
    title: "Weather Dashboard",
    description: "An interactive dashboard fetching real-time forecast data via external APIs.",
    link: "https://github.com/your-username/weather-app",
    tags: ["REST API", "JavaScript", "Async/Await"]
  }
];
---

<BaseLayout title="Projects | My Portfolio">
  <section>
    <h1>My Projects 💻</h1>
    <p>A collection of applications, tools, and experiments I've built.</p>

    <div class="project-grid">
      {allProjects.map((project) => (
        <article class="project-card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-link">
            View Source →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>