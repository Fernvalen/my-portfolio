---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkstationHero from '../components/WorkstationHero.astro';
import ExpertiseMarquee from '../components/ExpertiseMarquee.astro';

const base = import.meta.env.BASE_URL ?? '';
const normalizedBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<BaseLayout title="Fernando Valenzuela Jr. | Technology Leader & Quality Architect" pageKey="home">

  <!-- 🟢 NEW: View Switcher Banner -->
  <div class="version-banner">
    <span class="version-tag">VARIANT B: COMMAND CENTER</span>
    <a href={`${base}/`} class="version-switch-btn">Switch to Minimal View →</a>
  </div>
  
  <section class="hero-section">
    <div class="hero-badge">
      <span class="status-dot"></span> Available for Executive & Technical Leadership
    </div>
    
    <h1 class="hero-title">
      AI-Driven Quality Engineering, Product Ownership & Application Delivery
    </h1>
    
    <p class="hero-subtitle">
      Over 20 years architecting Enterprise Testing Centers of Excellence (TCoE), leading high-stakes cloud transformations, and establishing autonomous AI-driven quality engineering practices.
    </p>

    <div class="hero-actions">
      <a href={`${normalizedBase}/projects`} class="btn primary-btn">Explore Projects & Architecture →</a>
      <a href={`${normalizedBase}/contact`} class="btn secondary-btn">Get in Touch</a>
    </div>

    <!-- Custom Multi-Monitor Command Center SVG -->
    <WorkstationHero />
  </section>

  <!-- Dynamic Marquee Showcase -->
  <ExpertiseMarquee />
</BaseLayout>

<style>

  /* 🟢 NEW: Version Switcher Banner & Button Styles */
  .version-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(18, 7, 3, 0.85);
    border: 1px solid var(--border-color);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .version-tag {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--accent-orange);
    letter-spacing: 0.08em;
  }

  .version-switch-btn {
    font-size: 0.8rem;
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    transition: all 0.2s ease;
  }

  .version-switch-btn:hover {
    color: var(--accent-orange);
    background: rgba(234, 88, 12, 0.15);
  }
  /* ------*/

  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 1rem;
  }
  .hero-title {
    font-size: 2.3rem;
    font-weight: 800;
    max-width: 800px;
    line-height: 1.25;
    background: linear-gradient(135deg, #ffffff 30%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
  }
  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
</style>