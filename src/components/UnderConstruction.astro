---
interface Props {
  title?: string;
  customMessage?: string;
}

const { 
  title = "Under Construction", 
  customMessage = "This page is currently being upgraded and will be available shortly." 
} = Astro.props;

const base = import.meta.env.BASE_URL ?? '';
const homeUrl = base.endsWith('/') ? base : `${base}/`;
---

<div class="maintenance-container">
  <div class="maintenance-card" role="region" aria-label="Maintenance Notice">
    <div class="maintenance-icon" aria-hidden="true">🚧</div>
    <h1>{title}</h1>
    <p>{customMessage}</p>
    <a href={homeUrl} class="btn primary-btn">← Back to Home</a>
  </div>
</div>

<style>
  .maintenance-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 45vh;
    text-align: center;
    padding: 2rem 1rem;
  }
  .maintenance-card {
    border: 1px dashed var(--warning-border);
    background: var(--bg-secondary);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    max-width: 540px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5), 0 0 15px var(--warning-bg);
    position: relative;
  }
  .maintenance-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.4));
  }
  .maintenance-card h1 {
    color: var(--warning-text);
    margin-bottom: 0.75rem;
    font-size: 1.75rem;
  }
  .maintenance-card p {
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }
</style>