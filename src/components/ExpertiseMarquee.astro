---
// src/components/ExpertiseMarquee.astro

interface SkillItem {
  id: string;
  name: string;
  category: 'ai-data' | 'qe-auto' | 'cloud-devops' | 'product-gov';
  badgeColor: string;
}

const skills: SkillItem[] = [
  // AI & Data
  { id: "python", name: "Python / Pytest", category: "ai-data", badgeColor: "#38bdf8" },
  { id: "gcp", name: "Google Vertex AI", category: "ai-data", badgeColor: "#4285F4" },
  { id: "aws", name: "Amazon Bedrock & Cloud", category: "ai-data", badgeColor: "#FF9900" },
  { id: "sql", name: "SQL Server & ETL", category: "ai-data", badgeColor: "#00BCF2" },

  // QE & Automation
  { id: "selenium", name: "Selenium WebDriver", category: "qe-auto", badgeColor: "#43B02A" },
  { id: "playwright", name: "Playwright / Cypress", category: "qe-auto", badgeColor: "#2EAD33" },
  { id: "dynatrace", name: "Dynatrace APM", category: "qe-auto", badgeColor: "#14b8a6" },
  { id: "postman", name: "Postman API", category: "qe-auto", badgeColor: "#FF6C37" },

  // Cloud & DevOps
  { id: "docker", name: "Docker Containers", category: "cloud-devops", badgeColor: "#2496ED" },
  { id: "jenkins", name: "Jenkins CI/CD", category: "cloud-devops", badgeColor: "#D24939" },
  { id: "azure", name: "Azure DevOps", category: "cloud-devops", badgeColor: "#0078D7" },
  { id: "git", name: "Git & Pipelines", category: "cloud-devops", badgeColor: "#F05032" },

  // Product & Governance
  { id: "jira", name: "Jira / Xray / Zephyr", category: "product-gov", badgeColor: "#0052CC" },
  { id: "confluence", name: "Confluence Wiki", category: "product-gov", badgeColor: "#172B4D" },
  { id: "scrum", name: "Scrum Alliance (CSPO)", category: "product-gov", badgeColor: "#F59E0B" },
];
---

<section class="expertise-section">
  <div class="expertise-header">
    <p class="section-label">AREAS OF EXPERTISE & TOOLING</p>
    <h2>Enterprise Platforms, Frameworks & Modern Toolchain</h2>
  </div>

  <!-- Filter Controls -->
  <div class="marquee-controls" role="toolbar" aria-label="Filter skills by category">
    <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">All</button>
    <button type="button" class="filter-btn" data-filter="ai-data" aria-pressed="false">AI & Data</button>
    <button type="button" class="filter-btn" data-filter="qe-auto" aria-pressed="false">QE & Automation</button>
    <button type="button" class="filter-btn" data-filter="cloud-devops" aria-pressed="false">Cloud & DevOps</button>
    <button type="button" class="filter-btn" data-filter="product-gov" aria-pressed="false">Product & Governance</button>
  </div>

  <!-- Infinite Dynamic Marquee -->
  <div class="marquee-wrapper">
    <div class="marquee-track" id="marqueeTrack">
      {skills.concat(skills).map((skill) => (
        <div class="skill-chip" data-category={skill.category} style={`--accent-color: ${skill.badgeColor};`}>
          <div class="brand-svg-container">
            {skill.id === "python" && (
              <svg viewBox="0 0 24 24" fill="none" class="brand-svg" aria-hidden="true">
                <path d="M11.9 2c-5.2 0-4.8 2.2-4.8 2.2l.1 2.3h4.9v.7H5.2S2 6.8 2 12s2.8 4.9 2.8 4.9h1.7v-2.4s-.1-2.8 2.8-2.8h4.7s2.7.1 2.7-2.6V4.7S17.2 2 11.9 2zm-2.7 1.5a.9.9 0 110 1.8.9.9 0 010-1.8z" fill="#38bdf8"/>
                <path d="M12.1 22c5.2 0 4.8-2.2 4.8-2.2l-.1-2.3H11.9v-.7h6.9S22 17.2 22 12s-2.8-4.9-2.8-4.9h-1.7v2.4s.1 2.8-2.8 2.8h-4.7s-2.7-.1-2.7 2.6v4.4s-.5 2.7 4.8 2.7zm2.7-1.5a.9.9 0 110-1.8.9.9 0 010-1.8z" fill="#facc15"/>
              </svg>
            )}

            {skill.id === "aws" && (
              <svg viewBox="0 0 24 24" fill="#FF9900" class="brand-svg" aria-hidden="true">
                <path d="M6.9 14.8c-.8 0-1.4-.2-1.9-.6-.5-.4-.7-1-.7-1.7 0-.9.4-1.5 1.1-1.9.7-.4 1.7-.6 3-.6.6 0 1.2.1 1.7.2v-.4c0-.6-.1-1-.4-1.3-.3-.3-.8-.4-1.4-.4-.6 0-1.1.1-1.7.3-.6.2-1 .5-1.4.9l-.8-1.2c.5-.5 1.1-.9 1.8-1.1.8-.3 1.6-.4 2.4-.4 1.3 0 2.2.3 2.8.9.6.6.9 1.5.9 2.7v4.6h-1.8v-1c-.4.4-.8.7-1.3.9-.7.2-1.4.3-2.3.3zm.7-1.6c.5 0 1-.1 1.4-.4.4-.3.7-.6.8-1.1v-.8c-.4-.1-.9-.2-1.4-.2-.8 0-1.5.1-1.9.4-.4.3-.6.7-.6 1.2 0 .5.2.8.5 1 .3.1.7.2 1.2.2zM21.2 18.2c-5.6 3.4-13 3.6-18.4.6-.2-.1-.3-.4-.1-.6.2-.2.5-.2.7-.1 5 2.7 11.9 2.5 17.1-.7.4-.2.9.2.7.8z"/>
              </svg>
            )}

            {skill.id === "gcp" && (
              <svg viewBox="0 0 24 24" class="brand-svg" aria-hidden="true">
                <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z" fill="#4285F4"/>
              </svg>
            )}

            {skill.id === "selenium" && (
              <svg viewBox="0 0 24 24" fill="#43B02A" class="brand-svg" aria-hidden="true">
                <path d="M2 3h20v18H2V3zm17.5 15.5V5.5H4.5v13h15zM7.2 14.8l2.4-2.4-2.4-2.4 1.4-1.4 3.8 3.8-3.8 3.8-1.4-1.4zm5.6 1.2h5v2h-5v-2z"/>
              </svg>
            )}

            {skill.id === "playwright" && (
              <svg viewBox="0 0 24 24" fill="#2EAD33" class="brand-svg" aria-hidden="true">
                <path d="M17.4 3.6a4.8 4.8 0 00-4.8 4.8c0 .4 0 .8.1 1.2A5.4 5.4 0 008.4 8C5.4 8 3 10.4 3 13.4s2.4 5.4 5.4 5.4c.5 0 1 0 1.5-.2a4.8 4.8 0 004.3 2.8 4.8 4.8 0 004.8-4.8c0-.4 0-.8-.1-1.2A5.4 5.4 0 0021 13.4c0-3-2.4-5.4-5.4-5.4-.5 0-1 0-1.5.2a4.8 4.8 0 00-4.3-2.8c0-.6.4-1.1 1-1.4.6-.2 1.2-.2 1.8 0l.5-1.9c-.8-.3-1.8-.4-2.7-.1a4.8 4.8 0 00-3.5 3.5c-.3.9-.2 1.9.1 2.7L8.4 10A3.4 3.4 0 005 13.4c0 1.9 1.5 3.4 3.4 3.4.5 0 1 0 1.5-.2l.5 1.9c-.6.2-1.3.3-2 .3A5.4 5.4 0 013 13.4C3 10.4 5.4 8 8.4 8c.5 0 1 0 1.5.2l-.5-1.9c.6-.2 1.3-.3 2-.3 1.9 0 3.5 1.1 4.3 2.7.6-.2 1.2-.3 1.7-.3 1.9 0 3.4 1.5 3.4 3.4 0 1.9-1.5 3.4-3.4 3.4-.5 0-1 0-1.5-.2l.5-1.9c.6.2 1.3.3 2 .3a1.4 1.4 0 001.4-1.4 1.4 1.4 0 00-1.4-1.4c-.5 0-1 .1-1.4.3l-.5-1.9c.6-.2 1.2-.3 1.9-.3 1.9 0 3.4-1.5 3.4-3.4s-1.5-3.4-3.4-3.4z"/>
              </svg>
            )}

            {skill.id === "dynatrace" && (
              <svg viewBox="0 0 24 24" fill="#14b8a6" class="brand-svg" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14.5h-2v-6h2v6zm0-8h-2V6.5h2V8.5z"/>
                <circle cx="12" cy="12" r="9" stroke="#14b8a6" stroke-width="1.5" fill="none"/>
              </svg>
            )}

            {skill.id === "postman" && (
              <svg viewBox="0 0 24 24" fill="#FF6C37" class="brand-svg" aria-hidden="true">
                <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15.9V13h3.5l-4.5-6v4.9H8.5l4.5 6z"/>
              </svg>
            )}

            {skill.id === "docker" && (
              <svg viewBox="0 0 24 24" fill="#2496ED" class="brand-svg" aria-hidden="true">
                <path d="M13 7.5h2v2h-2zm-3 0h2v2h-2zm-3 0h2v2H7zm6-3h2v2h-2zm-3 0h2v2h-2zm9 7.8c-.5-.4-1.5-.4-2.1-.2-.2-.8-.8-1.5-1.6-1.9l-.6-.3-.4.5c-.3.4-.6 1-.7 1.6H2.3c-.2.7 0 2.2.8 3.5 1.1 1.7 3.2 2.7 6.2 2.7 5.8 0 9.8-3.1 10.9-6.3.8 0 1.7-.3 2.1-.8l.2-.3-.5-.5z"/>
              </svg>
            )}

            {skill.id === "jenkins" && (
              <svg viewBox="0 0 24 24" fill="#D24939" class="brand-svg" aria-hidden="true">
                <path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm1 15h-2v-2h2zm0-4h-2V7h2z"/>
                <path d="M12 4a8 8 0 00-8 8c0 2 .8 3.9 2.1 5.3L12 11l5.9 6.3A8 8 0 0012 4z" fill-opacity="0.2"/>
              </svg>
            )}

            {skill.id === "azure" && (
              <svg viewBox="0 0 24 24" fill="#0078D7" class="brand-svg" aria-hidden="true">
                <path d="M13.4 2.5L2 19.3h6.2l3.4-5.3 4.1 5.3H22L13.4 2.5zm-1.8 11.2l-2.4 3.7H4.8l6.8-10.1 2.2 3.6-2.2 2.8z"/>
              </svg>
            )}

            {skill.id === "git" && (
              <svg viewBox="0 0 24 24" fill="#F05032" class="brand-svg" aria-hidden="true">
                <path d="M21.7 10.6l-8.3-8.3c-.8-.8-2.1-.8-2.9 0L8.7 4.1l3.7 3.7c.9-.3 1.9 0 2.5.6.7.7.8 1.7.5 2.5l3.6 3.6c.9-.3 1.9 0 2.5.6 1 .9 1 2.5 0 3.5s-2.5 1-3.5 0c-.8-.8-1-2-.5-3l-3.3-3.3v5.1c.4.3.7.8.7 1.4 0 1.1-.9 2-2 2s-2-.9-2-2c0-.6.3-1.1.7-1.4V8.4c-.4-.3-.7-.8-.7-1.4 0-.6.3-1.1.7-1.4L5.1 2.3 2.3 5.1c-.8.8-.8 2.1 0 2.9l8.3 8.3c.8.8 2.1.8 2.9 0l8.2-8.2c.8-.8.8-2.1 0-2.9z"/>
              </svg>
            )}

            {skill.id === "jira" && (
              <svg viewBox="0 0 24 24" fill="#0052CC" class="brand-svg" aria-hidden="true">
                <path d="M11.5 2C6.3 2 2 6.3 2 11.5S6.3 21 11.5 21 21 16.7 21 11.5 16.7 2 11.5 2zm0 15.5c-2.2 0-4-1.8-4-4s1.8-4 4-4 4 1.8 4 4-1.8 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
              </svg>
            )}

            {skill.id === "sql" && (
              <svg viewBox="0 0 24 24" fill="#00BCF2" class="brand-svg" aria-hidden="true">
                <path d="M12 3c-4.4 0-8 1.3-8 3v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0-1.7-3.6-3-8-3zm0 2c3.9 0 6 1.1 6 1s-2.1 1-6 1-6-.1-6-1 2.1-1 6-1zm6 13c0-.1-2.1 1-6 1s-6-1.1-6-1v-2.2c1.7.8 4 1.2 6 1.2s4.3-.4 6-1.2V18zm0-4c0-.1-2.1 1-6 1s-6-1.1-6-1v-2.2c1.7.8 4 1.2 6 1.2s4.3-.4 6-1.2V14z"/>
              </svg>
            )}

            {skill.id === "confluence" && (
              <svg viewBox="0 0 24 24" fill="#38bdf8" class="brand-svg" aria-hidden="true">
                <path d="M4.5 15.5c-.8-1.2-1.3-2.6-1.4-4.1.3.1.6.1.9.1 2.5 0 4.6-1.7 5.2-4.1.6 2.3 2.7 4.1 5.2 4.1.3 0 .6 0 .9-.1-.1 1.5-.6 2.9-1.4 4.1-.7-1.1-1.9-1.8-3.3-1.8-1.4 0-2.6.7-3.3 1.8-.7-1.1-1.9-1.8-3.3-1.8-1.4 0-2.6.7-3.3 1.8z"/>
              </svg>
            )}

            {skill.id === "scrum" && (
              <svg viewBox="0 0 24 24" fill="#F59E0B" class="brand-svg" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            )}
          </div>
          <span class="chip-name">{skill.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const skillChips = document.querySelectorAll<HTMLElement>('.skill-chip');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      const filter = btn.getAttribute('data-filter');

      skillChips.forEach(chip => {
        const category = chip.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          chip.style.display = 'inline-flex';
        } else {
          chip.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .expertise-section {
    margin: 4rem 0 2rem 0;
    width: 100%;
    overflow: hidden;
  }
  .expertise-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .section-label {
    font-family: monospace;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: #38bdf8;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .expertise-header h2 {
    font-size: 1.4rem;
    color: #f8fafc;
  }
  .marquee-controls {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-btn {
    background: #0f172a;
    border: 1px solid #334155;
    color: #94a3b8;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    border-color: #38bdf8;
    color: #f8fafc;
  }
  .filter-btn.active {
    background: #1e293b;
    border-color: #38bdf8;
    color: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.25);
  }
  .marquee-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 0.5rem 0;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: scrollMarquee 34s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-left: 3px solid var(--accent-color);
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    white-space: nowrap;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .skill-chip:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color);
  }
  .brand-svg-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }
  .brand-svg {
    width: 100%;
    height: 100%;
  }
  .chip-name {
    color: #e2e8f0;
    font-size: 0.9rem;
    font-weight: 500;
  }
  @keyframes scrollMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-wrapper {
      mask-image: none;
      -webkit-mask-image: none;
      overflow-x: auto;
    }
    .marquee-track {
      animation: none !important;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
  }
</style>