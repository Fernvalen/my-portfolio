---
// src/components/WorkstationHero.astro
---

<div class="blueprint-container">
  <svg viewBox="0 0 800 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="blueprint-svg">
    <defs>
      <!-- Blueprint Fine Grid -->
      <pattern id="fineGrid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#1e293b" stroke-width="0.75" stroke-opacity="0.6"/>
      </pattern>
      <!-- Blueprint Major Grid -->
      <pattern id="majorGrid" width="100" height="100" patternUnits="userSpaceOnUse">
        <path d="M 100 0 L 0 0 0 100" fill="none" stroke="#334155" stroke-width="1.2" stroke-opacity="0.8"/>
      </pattern>
      
      <!-- Neon Glow Filters -->
      <filter id="glowCyan" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glowPurple" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glowGreen" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Center Radial Gradient -->
      <radialGradient id="blueprintVignette" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#0284c7" stop-opacity="0.12" />
        <stop offset="60%" stop-color="#030712" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#030712" stop-opacity="1" />
      </radialGradient>
    </defs>

    <!-- Blueprint Canvas & Grids -->
    <rect width="800" height="420" fill="#030712"/>
    <rect width="800" height="420" fill="url(#fineGrid)"/>
    <rect width="800" height="420" fill="url(#majorGrid)"/>
    <rect width="800" height="420" fill="url(#blueprintVignette)"/>

    <!-- Architectural Coordinate Markers -->
    <text x="25" y="30" fill="#38bdf8" font-size="9" font-family="monospace" opacity="0.8">// ARCH_SPEC: QE_COE_V6.4</text>
    <text x="25" y="45" fill="#64748b" font-size="8" font-family="monospace">SCALE: 1:1 [DISTRIBUTED_SYSTEMS]</text>
    <text x="640" y="30" fill="#38bdf8" font-size="9" font-family="monospace" opacity="0.8">SYS_AVAILABILITY: 99.8%</text>
    <text x="640" y="45" fill="#a855f7" font-size="8" font-family="monospace">STATE: DETERMINISTIC_AGENT</text>

    <!-- Crosshair Targets -->
    <g stroke="#38bdf8" stroke-width="1" opacity="0.5">
      <path d="M 400 15 L 400 35 M 390 25 L 410 25"/>
      <circle cx="400" cy="25" r="5" fill="none"/>
    </g>

    <!-- ================= CONDUIT BUSES & DATA PATHWAYS ================= -->
    <g stroke-linecap="round">
      <!-- Path 1: CI/CD Pipeline to Core -->
      <path d="M 170 190 L 290 190 L 340 220" stroke="#38bdf8" stroke-width="2" stroke-dasharray="6,4" opacity="0.75"/>
      <!-- Path 2: AI Engine to Core -->
      <path d="M 630 190 L 510 190 L 460 220" stroke="#a855f7" stroke-width="2" stroke-dasharray="6,4" opacity="0.75"/>
      <!-- Path 3: Core to Governance -->
      <path d="M 400 270 L 400 320" stroke="#22c55e" stroke-width="2" opacity="0.8"/>
    </g>

    <!-- ================= BLUEPRINT NODE 1: CI/CD & OBSERVABILITY (LEFT) ================= -->
    <g transform="translate(60, 110)">
      <rect x="0" y="0" width="220" height="150" rx="8" fill="#0f172a" fill-opacity="0.85" stroke="#38bdf8" stroke-width="1.5" filter="url(#glowCyan)"/>
      <line x1="0" y1="28" x2="220" y2="28" stroke="#1e293b" stroke-width="1.5"/>
      <text x="14" y="20" fill="#38bdf8" font-size="10" font-family="monospace" font-weight="700">01 / CI_CD_OBSERVABILITY</text>
      
      <!-- Sub-nodes -->
      <rect x="14" y="42" width="192" height="24" rx="4" fill="#020617" stroke="#334155"/>
      <circle cx="26" cy="54" r="3.5" fill="#22c55e"/>
      <text x="36" y="58" fill="#cbd5e1" font-size="9" font-family="monospace">Pact Contract Tests: PASS</text>

      <rect x="14" y="74" width="192" height="24" rx="4" fill="#020617" stroke="#334155"/>
      <circle cx="26" cy="86" r="3.5" fill="#38bdf8"/>
      <text x="36" y="90" fill="#cbd5e1" font-size="9" font-family="monospace">Dynatrace Apdex: 0.85+</text>

      <rect x="14" y="106" width="192" height="24" rx="4" fill="#020617" stroke="#334155"/>
      <circle cx="26" cy="118" r="3.5" fill="#eab308"/>
      <text x="36" y="122" fill="#cbd5e1" font-size="9" font-family="monospace">DevSecOps Gates: VERIFIED</text>
    </g>

    <!-- ================= BLUEPRINT NODE 2: AI AGENT ENGINE (RIGHT) ================= -->
    <g transform="translate(520, 110)">
      <rect x="0" y="0" width="220" height="150" rx="8" fill="#0f172a" fill-opacity="0.85" stroke="#a855f7" stroke-width="1.5" filter="url(#glowPurple)"/>
      <line x1="0" y1="28" x2="220" y2="28" stroke="#1e293b" stroke-width="1.5"/>
      <text x="14" y="20" fill="#c084fc" font-size="10" font-family="monospace" font-weight="700">02 / AI_AGENTIC_SYSTEM</text>
      
      <!-- Sub-nodes -->
      <rect x="14" y="42" width="192" height="24" rx="4" fill="#020617" stroke="#334155"/>
      <circle cx="26" cy="54" r="3.5" fill="#a855f7"/>
      <text x="36" y="58" fill="#cbd5e1" font-size="9" font-family="monospace">LangGraph State Routing</text>

      <rect x="14" y="74" width="192" height="24" rx="4" fill="#020617" stroke="#334155"/>
      <circle cx="26" cy="86" r="3.5" fill="#c084fc"/>
      <text x="36" y="90" fill="#cbd5e1" font-size="9" font-family="monospace">Pydantic Guardrail: 100%</text>

      <rect x="14" y="106" width="192" height="24" rx="4" fill="#020617" stroke="#334155"/>
      <circle cx="26" cy="118" r="3.5" fill="#22c55e"/>
      <text x="36" y="122" fill="#cbd5e1" font-size="9" font-family="monospace">Ollama / Vertex AI Bridge</text>
    </g>

    <!-- ================= CENTER NODE: QUALITY ARCHITECTURE CORE ================= -->
    <g transform="translate(320, 185)">
      <!-- Hexagonal / Rounded Core -->
      <rect x="0" y="0" width="160" height="75" rx="8" fill="#020617" stroke="#22c55e" stroke-width="2" filter="url(#glowGreen)"/>
      <circle cx="80" cy="24" r="9" fill="#064e3b" stroke="#22c55e" stroke-width="1.5"/>
      <circle cx="80" cy="24" r="3" fill="#86efac"/>
      <text x="80" y="46" fill="#f8fafc" font-size="10" font-family="monospace" font-weight="700" text-anchor="middle">QUALITY ARCHITECTURE</text>
      <text x="80" y="58" fill="#86efac" font-size="7.5" font-family="monospace" text-anchor="middle">ENTERPRISE TCoE HUB</text>
    </g>

    <!-- ================= BOTTOM NODE: GOVERNANCE & DELIVERY ================= -->
    <g transform="translate(285, 330)">
      <rect x="0" y="0" width="230" height="45" rx="6" fill="#0f172a" stroke="#475569" stroke-width="1.2"/>
      <text x="115" y="20" fill="#94a3b8" font-size="9" font-family="monospace" font-weight="700" text-anchor="middle">CAB & ARB GOVERNANCE</text>
      <text x="115" y="34" fill="#64748b" font-size="8" font-family="monospace" text-anchor="middle">SLO 99.8% • Defect Leakage -25%</text>
    </g>

    <!-- Decorative Corner Rulers -->
    <path d="M 15 15 L 45 15 M 15 15 L 15 45" stroke="#38bdf8" stroke-width="2"/>
    <path d="M 785 15 L 755 15 M 785 15 L 785 45" stroke="#a855f7" stroke-width="2"/>
    <path d="M 15 405 L 45 405 M 15 405 L 15 375" stroke="#38bdf8" stroke-width="2"/>
    <path d="M 785 405 L 755 405 M 785 405 L 785 375" stroke="#a855f7" stroke-width="2"/>
  </svg>
</div>

<style>
  .blueprint-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 1.5rem 0;
    position: relative;
  }
  .blueprint-svg {
    max-width: 780px;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(56, 189, 248, 0.2);
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(56, 189, 248, 0.08);
  }
</style>
